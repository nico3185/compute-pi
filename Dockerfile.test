# syntax=docker/dockerfile:1.4

FROM python:3.9-alpine

WORKDIR /app

# Install required packages and uv
RUN apk add --no-cache \
    gcc \
    musl-dev \
    python3-dev \
    libffi-dev \
    openssl-dev \
    make \
    curl \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && cp /root/.local/bin/uv /usr/local/bin/uv

# Copy configuration files first
COPY pyproject.toml README.md .flake8 ./
COPY compute_pi ./compute_pi

# Install the package and its dependencies
RUN export PATH=/root/.cargo/bin:$PATH && uv pip install --system -e .

# Install dev tools
RUN export PATH=/root/.cargo/bin:$PATH && uv pip install --system \
        black \
        isort \
        flake8 \
        mypy \
        pytest \
        pytest-cov \
        pytest-benchmark \
        types-tqdm \
        types-psutil

# Copy the rest of the project files
COPY tests ./tests
COPY benchmarks ./benchmarks
COPY Makefile ./

# Run make check by default
CMD ["make", "check"] 